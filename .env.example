# producer-tag-on-merge settings. Copy and fill in:
#   cp .env.example ~/.config/producer-tag-on-merge/env && chmod 600 ~/.config/producer-tag-on-merge/env
# Full reference: docs/configuration.md
#
# Format: KEY=value, one per line, no quotes and no spaces around '='. The same file works with
# `producer-tag-on-merge --env-file`, `docker run --env-file` and Docker Compose.
# Never commit a filled-in copy (.env is in .gitignore).

# --- Accounts (at least one) ----------------------------------------------------------------

# GitHub: classic PAT with `repo`, or fine-grained with Pull requests: Read + Metadata: Read.
# Shortcut: paste the output of `gh auth token` (values are literal: no $(...) in this file).
GITHUB_TOKEN=
# GitHub Enterprise Server: https://<host>/api/v3
# GITHUB_API_URL=https://api.github.com

# GitLab: personal access token with the read_api scope.
GITLAB_TOKEN=
# Self-hosted GitLab:
# GITLAB_URL=https://gitlab.com

# --- What triggers a tag --------------------------------------------------------------------

# mine  = PRs/MRs you authored, in any repo the token can see.
# repos = every merge in GITHUB_REPOS / GITLAB_PROJECTS; each author's own tag plays.
WATCH=mine

# Only for WATCH=repos. Comma-separated.
# GITHUB_REPOS=acme/api,acme/web,some-org
# GITLAB_PROJECTS=acme/backend/api,acme/frontend

# Seconds between checks (15-3600).
POLL_INTERVAL_SECONDS=60

# After the machine was asleep/offline, merges older than this many minutes stay silent.
CATCH_UP_MINUTES=30

# At most this many tags per check (e.g. a release merging 20 PRs at once).
MAX_PLAYS_PER_POLL=3

# --- Sound ----------------------------------------------------------------------------------

# Folder with default.<ext> (your tag) and optional github/<user>.<ext>, gitlab/<user>.<ext>.
# Native default: ~/.config/producer-tag-on-merge/tags. Docker image: /tags (mount the host
# folder there). Leave unset in a file used with Docker.
# TAGS_DIR=

# auto, paplay, pw-play, aplay, afplay, command, none
PLAYER=auto
# Only for PLAYER=command. {file} and {volume} (0-100) are substituted; no shell.
# PLAYER_COMMAND=ffplay -nodisp -autoexit -loglevel quiet {file}

# 0-100
VOLUME=100

# Kill the player after this many seconds.
PLAY_TIMEOUT_SECONDS=15

# No sound in this range (HH:MM-HH:MM in TIMEZONE). Merges are still recorded.
# QUIET_HOURS=22:00-08:00
TIMEZONE=UTC

# --- Runtime --------------------------------------------------------------------------------

# State directory. Leave unset in a file used with Docker (the image uses /data). Native default:
# ~/.local/share/producer-tag-on-merge (Linux), ~/Library/Application Support/... (macOS).
# DATA_DIR=

# error, warn, info, debug, trace
RUST_LOG=info
