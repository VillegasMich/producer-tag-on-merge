# systemd *user* unit: runs the producer-tag-on-merge binary in your session, where the audio
# server lives. Installed by scripts/install.sh to
# ~/.config/systemd/user/producer-tag-on-merge.service, which replaces @BIN@.
[Unit]
Description=producer-tag-on-merge (native)
Documentation=https://github.com/VillegasMich/producer-tag-on-merge
After=pipewire-pulse.service pulseaudio.service

[Service]
Type=simple
ExecStart=@BIN@ --env-file %h/.config/producer-tag-on-merge/env daemon
Restart=always
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=default.target
